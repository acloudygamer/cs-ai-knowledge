{
  "enabledMcpjsonServers": [
    "MiniMax",
    "context7",
    "sequential-thinking",
    "github",
    "firecrawl"
  ],
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/cycle_status_hook.py pre {agent_id}"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/cycle_status_hook.py post {agent_id}"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/directory_structure_hook.py"
          }
        ]
      }
    ]
  }
}
